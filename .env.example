# Postgres. Local: `npm run db:up` (docker-compose.yml). Hosted: Neon, Supabase, Railway…
DATABASE_URL="postgresql://atelier:atelier@localhost:5432/atelier"
# Direct (non-pooled) connection used for migrations; same as DATABASE_URL unless your host pools connections
DATABASE_URL_UNPOOLED="postgresql://atelier:atelier@localhost:5432/atelier"
# Long random string used to sign session cookies: `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-long-random-string"

# Stripe Connect (leave empty to run in demo mode: payments + author transfers are simulated)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""          # endpoint for "Your account" events
STRIPE_CONNECT_WEBHOOK_SECRET=""  # endpoint for "Connected accounts" events (account.updated)
# Optional public URL for links in emails and Stripe redirects. On Vercel it defaults to the
# production domain automatically (custom domain once added), so you can leave this empty.
APP_URL=""

# Protects /api/cron/release-payouts (daily job that releases held author payouts)
CRON_SECRET=""

# Email via Resend (leave empty to print emails to the server log)
RESEND_API_KEY=""
EMAIL_FROM="South Texas Book & Author <info@southtexasbookanauthor.com>"

# Shown on /terms, /privacy and /contact (placeholders appear until set)
LEGAL_COMPANY_NAME=""
LEGAL_ADDRESS=""
LEGAL_JURISDICTION=""
SUPPORT_EMAIL="info@southtexasbookanauthor.com"

# Image uploads in production: any S3-compatible bucket (leave S3_BUCKET empty to store in ./uploads locally)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT="https://bfa8e5487ad76dd8e0557e0f44b6dbac.r2.cloudflarestorage.com"          # e.g. https://<account>.r2.cloudflarestorage.com (omit for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://pub-acbd724de1614fc5a2c987b250734669.r2.dev"        # public base URL for the bucket, e.g. https://images.your-domain.com

# Footer social links (shown only when set)
SOCIAL_FACEBOOK=""
SOCIAL_INSTAGRAM=""
SOCIAL_LINKEDIN=""
SOCIAL_TIKTOK=""
SOCIAL_X=""
